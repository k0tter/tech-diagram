   "parent": "region", "col": 2, "row": 2, "step": 4},
  {"id": "lambda", "label": "Lambda\nビジネスロジック", "icon": "lambda",
   "parent": "region", "col": 3, "row": 1, "step": 5},
  {"id": "ddb", "label": "DynamoDB\nデータストア", "icon": "dynamodb",
   "parent": "region", "col": 4, "row": 1, "step": 6}
 ],
 "edges": [
  {"id": "e1", "src": "users", "dst": "cf", "kind": "main"},
